# ── Database (Supabase Postgres, project "aussiefit", region ap-southeast-2) ──
# Supabase dashboard → Connect → ORMs → Prisma gives both strings.
# Pooled (transaction mode, port 6543) — used by the app at runtime:
DATABASE_URL="postgresql://postgres.hcqvkhzhjuzfonfzraud:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct/session (port 5432) — used by `prisma db push`:
DIRECT_URL="postgresql://postgres.hcqvkhzhjuzfonfzraud:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# ── Auth ──
NEXTAUTH_SECRET=   # openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.com

# ── Payments (optional until launch; checkout returns 503 in prod without them) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ── Email (password reset) ──
RESEND_API_KEY=
